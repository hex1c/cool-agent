{
  "Comment": "Email workflow: intake \u2192 extraction \u2192 drafting \u2192 clarification \u2192 confirmation \u2192 SMTP send (Task 38). Standard workflow with durable human waits, task-token resume, three-attempt retries, and terminal failure paths. Ambiguous SMTP outcomes enter manual review, never automatic retry.",
  "StartAt": "ValidateIntake",
  "TimeoutSeconds": 86400,
  "States": {
    "ValidateIntake": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WebhookFunction}",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "IntakeFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.intakeResult",
      "Next": "ReserveIntakeBudget"
    },
    "CollectAttachments": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AttachmentCollectionFunction}",
        "Payload.$": "$.intakeResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "AttachmentFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.attachmentResult",
      "Next": "WaitForAttachmentDone"
    },
    "WaitForAttachmentDone": {
      "Type": "Wait",
      "SecondsPath": "$.attachmentResult.waitSeconds",
      "Next": "CheckAttachmentStatus"
    },
    "CheckAttachmentStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.attachmentResult.status",
          "StringEquals": "done",
          "Next": "ReserveAiBudget"
        },
        {
          "Variable": "$.attachmentResult.status",
          "StringEquals": "stopped",
          "Next": "WorkflowStopped"
        },
        {
          "Variable": "$.attachmentResult.status",
          "StringEquals": "timed_out",
          "Next": "AttachmentTimedOut"
        }
      ],
      "Default": "AttachmentTimedOut"
    },
    "RunExtraction": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AgentHarnessFunction}",
        "Payload.$": "$.attachmentResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ExtractionFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.extractionResult",
      "Next": "CheckExtractionOutcome"
    },
    "CheckExtractionOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "success",
          "Next": "RunDrafting"
        },
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "invalid",
          "Next": "ExtractionInvalid"
        },
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "retryable_error",
          "Next": "RunExtraction"
        },
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "terminal_error",
          "Next": "ExtractionFailed"
        }
      ],
      "Default": "ExtractionFailed"
    },
    "RunDrafting": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AgentHarnessFunction}",
        "Payload.$": "$.extractionResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "DraftingFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.draftingResult",
      "Next": "WaitForClarification"
    },
    "WaitForClarification": {
      "Type": "Wait",
      "SecondsPath": "$.draftingResult.clarificationWaitSeconds",
      "Next": "CheckClarificationStatus"
    },
    "CheckClarificationStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.clarification.status",
          "StringEquals": "provided",
          "Next": "RunDrafting"
        },
        {
          "Variable": "$.clarification.status",
          "StringEquals": "skipped",
          "Next": "RequestConfirmation"
        },
        {
          "Variable": "$.clarification.status",
          "StringEquals": "timed_out",
          "Next": "ClarificationTimedOut"
        },
        {
          "Variable": "$.clarification.status",
          "StringEquals": "cancelled",
          "Next": "WorkflowStopped"
        }
      ],
      "Default": "ClarificationTimedOut"
    },
    "RequestConfirmation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${WorkflowActionFunction}",
        "Payload": {
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "taskToken.$": "$$.Task.Token",
          "preview.$": "$.draftingResult.preview"
        }
      },
      "TimeoutSecondsPath": "$.draftingResult.confirmationTimeoutSeconds",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "Next": "ConfirmationTimedOut"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ConfirmationFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.confirmationResult",
      "Next": "CheckConfirmationOutcome"
    },
    "CheckConfirmationOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "confirmed",
          "Next": "ReserveEmailBudget"
        },
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "corrected",
          "Next": "RunDrafting"
        },
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "cancelled",
          "Next": "WorkflowStopped"
        },
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "stale",
          "Next": "ConfirmationStale"
        }
      ],
      "Default": "ConfirmationFailed"
    },
    "SendEmail": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EmailActionsFunction}",
        "Payload.$": "$.confirmationResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "EmailActionFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.emailResult",
      "Next": "CheckEmailOutcome"
    },
    "CheckEmailOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.emailResult.outcome",
          "StringEquals": "accepted",
          "Next": "SettleEmailBudget"
        },
        {
          "Variable": "$.emailResult.outcome",
          "StringEquals": "retryable_failure",
          "Next": "ReserveEmailBudget"
        },
        {
          "Variable": "$.emailResult.outcome",
          "StringEquals": "ambiguous",
          "Next": "MarkEmailManualReview"
        },
        {
          "Variable": "$.emailResult.outcome",
          "StringEquals": "terminal_failure",
          "Next": "EmailActionFailed"
        }
      ],
      "Default": "EmailActionFailed"
    },
    "CompleteWorkflow": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowActionFunction}",
        "Payload.$": "$.emailResult"
      },
      "End": true
    },
    "IntakeFailed": {
      "Type": "Fail",
      "Cause": "Webhook intake failed after retries",
      "Error": "IntakeFailed"
    },
    "AttachmentFailed": {
      "Type": "Fail",
      "Cause": "Attachment collection failed after retries",
      "Error": "AttachmentFailed"
    },
    "AttachmentTimedOut": {
      "Type": "Fail",
      "Cause": "Attachment collection timed out",
      "Error": "AttachmentTimedOut"
    },
    "ExtractionInvalid": {
      "Type": "Fail",
      "Cause": "AI extraction produced invalid output",
      "Error": "ExtractionInvalid"
    },
    "ExtractionFailed": {
      "Type": "Fail",
      "Cause": "AI extraction failed after retries",
      "Error": "ExtractionFailed"
    },
    "DraftingFailed": {
      "Type": "Fail",
      "Cause": "Email drafting failed after retries",
      "Error": "DraftingFailed"
    },
    "ClarificationTimedOut": {
      "Type": "Fail",
      "Cause": "Clarification wait timed out",
      "Error": "ClarificationTimedOut"
    },
    "ConfirmationTimedOut": {
      "Type": "Fail",
      "Cause": "Confirmation wait timed out",
      "Error": "ConfirmationTimedOut"
    },
    "ConfirmationFailed": {
      "Type": "Fail",
      "Cause": "Confirmation processing failed",
      "Error": "ConfirmationFailed"
    },
    "ConfirmationStale": {
      "Type": "Fail",
      "Cause": "Confirmation was stale or replayed",
      "Error": "ConfirmationStale"
    },
    "EmailActionFailed": {
      "Type": "Fail",
      "Cause": "Email send failed after retries",
      "Error": "EmailActionFailed"
    },
    "EmailManualReview": {
      "Type": "Fail",
      "Cause": "SMTP outcome ambiguous; manual review required. Never auto-retry ambiguous sends.",
      "Error": "EmailManualReview"
    },
    "WorkflowStopped": {
      "Type": "Fail",
      "Cause": "Workflow stopped by participant",
      "Error": "WorkflowStopped"
    },
    "ReserveIntakeBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardIntakeFunction}",
        "Payload": {
          "action": "reserve",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "reservationId.$": "States.Format('{}-intake', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.intakeBudgetResult",
      "Next": "CheckIntakeBudget"
    },
    "CheckIntakeBudget": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.intakeBudgetResult.Payload.authorized",
          "BooleanEquals": true,
          "Next": "CollectAttachments"
        }
      ],
      "Default": "BudgetDenied"
    },
    "ReserveAiBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardAiFunction}",
        "Payload": {
          "action": "reserve",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "reservationId.$": "States.Format('{}-ai', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.aiBudgetResult",
      "Next": "CheckAiBudget"
    },
    "CheckAiBudget": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.aiBudgetResult.Payload.authorized",
          "BooleanEquals": true,
          "Next": "RunExtraction"
        }
      ],
      "Default": "BudgetDenied"
    },
    "ReserveEmailBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardExternalFunction}",
        "Payload": {
          "action": "reserve",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "reservationId.$": "States.Format('{}-email', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.externalBudgetResult",
      "Next": "CheckEmailBudget"
    },
    "CheckEmailBudget": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.externalBudgetResult.Payload.authorized",
          "BooleanEquals": true,
          "Next": "SendEmail"
        }
      ],
      "Default": "BudgetDenied"
    },
    "SettleEmailBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "settle",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.externalBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-email', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.emailSettlementResult",
      "Next": "SettleAiBudget"
    },
    "MarkEmailManualReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "manual_review",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.externalBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-email', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.emailManualReviewResult",
      "Next": "EmailManualReview"
    },
    "BudgetDenied": {
      "Type": "Fail",
      "Error": "BudgetDenied",
      "Cause": "Environment budget guard denied the operation"
    },
    "BudgetGuardUnavailable": {
      "Type": "Fail",
      "Error": "BudgetGuardUnavailable",
      "Cause": "Environment budget guard was unavailable; failed closed"
    },
    "SettleAiBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "settle",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.aiBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-ai', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.aiSettlementResult",
      "Next": "SettleIntakeBudget"
    },
    "SettleIntakeBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "settle",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.intakeBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-intake', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.intakeSettlementResult",
      "Next": "CompleteWorkflow"
    }
  }
}
