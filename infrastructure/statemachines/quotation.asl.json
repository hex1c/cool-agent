{
  "Comment": "Quotation workflow: intake → extraction → calculation → clarification → confirmation → Sheet/Doc creation → PDF render → artifact delivery (Task 38). Standard workflow with durable human waits, task-token resume, three-attempt retries, and terminal failure paths.",
  "StartAt": "ValidateIntake",
  "TimeoutSeconds": 86400,
  "States": {
    "ValidateIntake": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WebhookFunction}",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "IntakeFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.intakeResult",
      "Next": "CollectAttachments"
    },
    "CollectAttachments": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AttachmentCollectionFunction}",
        "Payload.$": "$.intakeResult"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "AttachmentFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.attachmentResult",
      "Next": "WaitForAttachmentDone"
    },
    "WaitForAttachmentDone": {
      "Type": "Wait",
      "SecondsPath": "$.attachmentResult.waitSeconds",
      "Next": "CheckAttachmentStatus"
    },
    "CheckAttachmentStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.attachmentResult.status",
          "StringEquals": "done",
          "Next": "RunExtraction"
        },
        {
          "Variable": "$.attachmentResult.status",
          "StringEquals": "stopped",
          "Next": "WorkflowStopped"
        },
        {
          "Variable": "$.attachmentResult.status",
          "StringEquals": "timed_out",
          "Next": "AttachmentTimedOut"
        }
      ],
      "Default": "AttachmentTimedOut"
    },
    "RunExtraction": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AgentHarnessFunction}",
        "Payload.$": "$.attachmentResult"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ExtractionFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.extractionResult",
      "Next": "CheckExtractionOutcome"
    },
    "CheckExtractionOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "success",
          "Next": "RunCalculation"
        },
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "invalid",
          "Next": "ExtractionInvalid"
        },
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "retryable_error",
          "Next": "RunExtraction"
        },
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "terminal_error",
          "Next": "ExtractionFailed"
        }
      ],
      "Default": "ExtractionFailed"
    },
    "RunCalculation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AgentHarnessFunction}",
        "Payload.$": "$.extractionResult"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "CalculationFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.calculationResult",
      "Next": "WaitForClarification"
    },
    "WaitForClarification": {
      "Type": "Wait",
      "SecondsPath": "$.calculationResult.clarificationWaitSeconds",
      "Next": "CheckClarificationStatus"
    },
    "CheckClarificationStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.clarification.status",
          "StringEquals": "provided",
          "Next": "RunCalculation"
        },
        {
          "Variable": "$.clarification.status",
          "StringEquals": "skipped",
          "Next": "RequestConfirmation"
        },
        {
          "Variable": "$.clarification.status",
          "StringEquals": "timed_out",
          "Next": "ClarificationTimedOut"
        },
        {
          "Variable": "$.clarification.status",
          "StringEquals": "cancelled",
          "Next": "WorkflowStopped"
        }
      ],
      "Default": "ClarificationTimedOut"
    },
    "RequestConfirmation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${WorkflowActionFunction}",
        "Payload": {
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "taskToken.$": "$$.Task.Token",
          "preview.$": "$.calculationResult.preview"
        }
      },
      "TimeoutSecondsPath": "$.calculationResult.confirmationTimeoutSeconds",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "Next": "ConfirmationTimedOut"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ConfirmationFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.confirmationResult",
      "Next": "CheckConfirmationOutcome"
    },
    "CheckConfirmationOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "confirmed",
          "Next": "CreateSheetOrDoc"
        },
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "corrected",
          "Next": "RunCalculation"
        },
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "cancelled",
          "Next": "WorkflowStopped"
        },
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "stale",
          "Next": "ConfirmationStale"
        }
      ],
      "Default": "ConfirmationFailed"
    },
    "CreateSheetOrDoc": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GoogleActionsFunction}",
        "Payload.$": "$.confirmationResult"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ExternalActionFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.sheetDocResult",
      "Next": "CheckSheetDocOutcome"
    },
    "CheckSheetDocOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sheetDocResult.outcome",
          "StringEquals": "accepted",
          "Next": "RenderPdf"
        },
        {
          "Variable": "$.sheetDocResult.outcome",
          "StringEquals": "retryable_failure",
          "Next": "CreateSheetOrDoc"
        },
        {
          "Variable": "$.sheetDocResult.outcome",
          "StringEquals": "ambiguous",
          "Next": "ExternalActionManualReview"
        },
        {
          "Variable": "$.sheetDocResult.outcome",
          "StringEquals": "terminal_failure",
          "Next": "ExternalActionFailed"
        }
      ],
      "Default": "ExternalActionFailed"
    },
    "RenderPdf": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PdfRenderFunction}",
        "Payload.$": "$.sheetDocResult"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PdfRenderFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.pdfResult",
      "Next": "DeliverArtifacts"
    },
    "DeliverArtifacts": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DeliveryFunction}",
        "Payload.$": "$.pdfResult"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "DeliveryFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.deliveryResult",
      "Next": "CheckDeliveryOutcome"
    },
    "CheckDeliveryOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.deliveryResult.outcome",
          "StringEquals": "accepted",
          "Next": "CompleteWorkflow"
        },
        {
          "Variable": "$.deliveryResult.outcome",
          "StringEquals": "retryable_failure",
          "Next": "DeliverArtifacts"
        },
        {
          "Variable": "$.deliveryResult.outcome",
          "StringEquals": "ambiguous",
          "Next": "DeliveryManualReview"
        },
        {
          "Variable": "$.deliveryResult.outcome",
          "StringEquals": "terminal_failure",
          "Next": "DeliveryFailed"
        }
      ],
      "Default": "DeliveryFailed"
    },
    "CompleteWorkflow": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowActionFunction}",
        "Payload.$": "$.deliveryResult"
      },
      "End": true
    },
    "IntakeFailed": {
      "Type": "Fail",
      "Cause": "Webhook intake failed after retries",
      "Error": "IntakeFailed"
    },
    "AttachmentFailed": {
      "Type": "Fail",
      "Cause": "Attachment collection failed after retries",
      "Error": "AttachmentFailed"
    },
    "AttachmentTimedOut": {
      "Type": "Fail",
      "Cause": "Attachment collection timed out",
      "Error": "AttachmentTimedOut"
    },
    "ExtractionInvalid": {
      "Type": "Fail",
      "Cause": "AI extraction produced invalid output",
      "Error": "ExtractionInvalid"
    },
    "ExtractionFailed": {
      "Type": "Fail",
      "Cause": "AI extraction failed after retries",
      "Error": "ExtractionFailed"
    },
    "CalculationFailed": {
      "Type": "Fail",
      "Cause": "Quotation calculation failed after retries",
      "Error": "CalculationFailed"
    },
    "ClarificationTimedOut": {
      "Type": "Fail",
      "Cause": "Clarification wait timed out",
      "Error": "ClarificationTimedOut"
    },
    "ConfirmationTimedOut": {
      "Type": "Fail",
      "Cause": "Confirmation wait timed out",
      "Error": "ConfirmationTimedOut"
    },
    "ConfirmationFailed": {
      "Type": "Fail",
      "Cause": "Confirmation processing failed",
      "Error": "ConfirmationFailed"
    },
    "ConfirmationStale": {
      "Type": "Fail",
      "Cause": "Confirmation was stale or replayed",
      "Error": "ConfirmationStale"
    },
    "ExternalActionFailed": {
      "Type": "Fail",
      "Cause": "Google Sheet/Doc creation failed after retries",
      "Error": "ExternalActionFailed"
    },
    "ExternalActionManualReview": {
      "Type": "Fail",
      "Cause": "Google Sheet/Doc outcome ambiguous; manual review required",
      "Error": "ExternalActionManualReview"
    },
    "PdfRenderFailed": {
      "Type": "Fail",
      "Cause": "PDF rendering failed",
      "Error": "PdfRenderFailed"
    },
    "DeliveryFailed": {
      "Type": "Fail",
      "Cause": "Artifact delivery failed after retries",
      "Error": "DeliveryFailed"
    },
    "DeliveryManualReview": {
      "Type": "Fail",
      "Cause": "Delivery outcome ambiguous; manual review required",
      "Error": "DeliveryManualReview"
    },
    "WorkflowStopped": {
      "Type": "Fail",
      "Cause": "Workflow stopped by participant",
      "Error": "WorkflowStopped"
    }
  }
}
