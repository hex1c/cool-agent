{
  "Comment": "Quotation workflow: intake \u2192 extraction \u2192 calculation \u2192 clarification \u2192 confirmation \u2192 Sheet/Doc creation \u2192 PDF render \u2192 artifact delivery (Task 38). Standard workflow with durable human waits, task-token resume, three-attempt retries, and terminal failure paths.",
  "StartAt": "ReserveIntakeBudget",
  "TimeoutSeconds": 86400,
  "States": {
    "CollectAttachments": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AttachmentCollectionFunction}",
        "Payload.$": "$.intakeResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "AttachmentFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.attachmentResult",
      "Next": "WaitForAttachmentDone"
    },
    "WaitForAttachmentDone": {
      "Type": "Wait",
      "SecondsPath": "$.attachmentResult.waitSeconds",
      "Next": "CheckAttachmentStatus"
    },
    "CheckAttachmentStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.attachmentResult.status",
          "StringEquals": "done",
          "Next": "ReserveAiBudget"
        },
        {
          "Variable": "$.attachmentResult.status",
          "StringEquals": "stopped",
          "Next": "WorkflowStopped"
        },
        {
          "Variable": "$.attachmentResult.status",
          "StringEquals": "timed_out",
          "Next": "AttachmentTimedOut"
        }
      ],
      "Default": "AttachmentTimedOut"
    },
    "RunExtraction": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AgentHarnessFunction}",
        "Payload.$": "$.attachmentResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ExtractionFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.extractionResult",
      "Next": "CheckExtractionOutcome"
    },
    "CheckExtractionOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "success",
          "Next": "RunCalculation"
        },
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "invalid",
          "Next": "ExtractionInvalid"
        },
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "retryable_error",
          "Next": "RunExtraction"
        },
        {
          "Variable": "$.extractionResult.outcome",
          "StringEquals": "terminal_error",
          "Next": "ExtractionFailed"
        }
      ],
      "Default": "ExtractionFailed"
    },
    "RunCalculation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AgentHarnessFunction}",
        "Payload.$": "$.extractionResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "CalculationFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.calculationResult",
      "Next": "WaitForClarification"
    },
    "WaitForClarification": {
      "Type": "Wait",
      "SecondsPath": "$.calculationResult.clarificationWaitSeconds",
      "Next": "CheckClarificationStatus"
    },
    "CheckClarificationStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.clarification.status",
          "StringEquals": "provided",
          "Next": "RunCalculation"
        },
        {
          "Variable": "$.clarification.status",
          "StringEquals": "skipped",
          "Next": "RequestConfirmation"
        },
        {
          "Variable": "$.clarification.status",
          "StringEquals": "timed_out",
          "Next": "ClarificationTimedOut"
        },
        {
          "Variable": "$.clarification.status",
          "StringEquals": "cancelled",
          "Next": "WorkflowStopped"
        }
      ],
      "Default": "ClarificationTimedOut"
    },
    "RequestConfirmation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${WorkflowActionFunction}",
        "Payload": {
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "taskToken.$": "$$.Task.Token",
          "preview.$": "$.calculationResult.preview"
        }
      },
      "TimeoutSecondsPath": "$.calculationResult.confirmationTimeoutSeconds",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "Next": "ConfirmationTimedOut"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ConfirmationFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.confirmationResult",
      "Next": "CheckConfirmationOutcome"
    },
    "CheckConfirmationOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "confirmed",
          "Next": "ReserveSheetDocBudget"
        },
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "corrected",
          "Next": "RunCalculation"
        },
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "cancelled",
          "Next": "WorkflowStopped"
        },
        {
          "Variable": "$.confirmationResult.outcome",
          "StringEquals": "stale",
          "Next": "ConfirmationStale"
        }
      ],
      "Default": "ConfirmationFailed"
    },
    "CreateSheetOrDoc": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GoogleActionsFunction}",
        "Payload.$": "$.confirmationResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ExternalActionFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.sheetDocResult",
      "Next": "CheckSheetDocOutcome"
    },
    "CheckSheetDocOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sheetDocResult.outcome",
          "StringEquals": "accepted",
          "Next": "SettleSheetDocBudget"
        },
        {
          "Variable": "$.sheetDocResult.outcome",
          "StringEquals": "retryable_failure",
          "Next": "ReserveSheetDocBudget"
        },
        {
          "Variable": "$.sheetDocResult.outcome",
          "StringEquals": "ambiguous",
          "Next": "MarkSheetDocManualReview"
        },
        {
          "Variable": "$.sheetDocResult.outcome",
          "StringEquals": "terminal_failure",
          "Next": "ExternalActionFailed"
        }
      ],
      "Default": "ExternalActionFailed"
    },
    "RenderPdf": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PdfRenderFunction}",
        "Payload.$": "$.sheetDocResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PdfRenderFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.pdfResult",
      "Next": "ReserveDeliveryBudget"
    },
    "DeliverArtifacts": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DeliveryFunction}",
        "Payload.$": "$.pdfResult"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "DeliveryFailed",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.deliveryResult",
      "Next": "CheckDeliveryOutcome"
    },
    "CheckDeliveryOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.deliveryResult.outcome",
          "StringEquals": "accepted",
          "Next": "SettleDeliveryBudget"
        },
        {
          "Variable": "$.deliveryResult.outcome",
          "StringEquals": "retryable_failure",
          "Next": "ReserveDeliveryBudget"
        },
        {
          "Variable": "$.deliveryResult.outcome",
          "StringEquals": "ambiguous",
          "Next": "MarkDeliveryManualReview"
        },
        {
          "Variable": "$.deliveryResult.outcome",
          "StringEquals": "terminal_failure",
          "Next": "DeliveryFailed"
        }
      ],
      "Default": "DeliveryFailed"
    },
    "CompleteWorkflow": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowActionFunction}",
        "Payload.$": "$.deliveryResult"
      },
      "End": true
    },
    "IntakeFailed": {
      "Type": "Fail",
      "Cause": "Webhook intake failed after retries",
      "Error": "IntakeFailed"
    },
    "AttachmentFailed": {
      "Type": "Fail",
      "Cause": "Attachment collection failed after retries",
      "Error": "AttachmentFailed"
    },
    "AttachmentTimedOut": {
      "Type": "Fail",
      "Cause": "Attachment collection timed out",
      "Error": "AttachmentTimedOut"
    },
    "ExtractionInvalid": {
      "Type": "Fail",
      "Cause": "AI extraction produced invalid output",
      "Error": "ExtractionInvalid"
    },
    "ExtractionFailed": {
      "Type": "Fail",
      "Cause": "AI extraction failed after retries",
      "Error": "ExtractionFailed"
    },
    "CalculationFailed": {
      "Type": "Fail",
      "Cause": "Quotation calculation failed after retries",
      "Error": "CalculationFailed"
    },
    "ClarificationTimedOut": {
      "Type": "Fail",
      "Cause": "Clarification wait timed out",
      "Error": "ClarificationTimedOut"
    },
    "ConfirmationTimedOut": {
      "Type": "Fail",
      "Cause": "Confirmation wait timed out",
      "Error": "ConfirmationTimedOut"
    },
    "ConfirmationFailed": {
      "Type": "Fail",
      "Cause": "Confirmation processing failed",
      "Error": "ConfirmationFailed"
    },
    "ConfirmationStale": {
      "Type": "Fail",
      "Cause": "Confirmation was stale or replayed",
      "Error": "ConfirmationStale"
    },
    "ExternalActionFailed": {
      "Type": "Fail",
      "Cause": "Google Sheet/Doc creation failed after retries",
      "Error": "ExternalActionFailed"
    },
    "ExternalActionManualReview": {
      "Type": "Fail",
      "Cause": "Google Sheet/Doc outcome ambiguous; manual review required",
      "Error": "ExternalActionManualReview"
    },
    "PdfRenderFailed": {
      "Type": "Fail",
      "Cause": "PDF rendering failed",
      "Error": "PdfRenderFailed"
    },
    "DeliveryFailed": {
      "Type": "Fail",
      "Cause": "Artifact delivery failed after retries",
      "Error": "DeliveryFailed"
    },
    "DeliveryManualReview": {
      "Type": "Fail",
      "Cause": "Delivery outcome ambiguous; manual review required",
      "Error": "DeliveryManualReview"
    },
    "WorkflowStopped": {
      "Type": "Fail",
      "Cause": "Workflow stopped by participant",
      "Error": "WorkflowStopped"
    },
    "ReserveIntakeBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardIntakeFunction}",
        "Payload": {
          "action": "reserve",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "reservationId.$": "States.Format('{}-intake', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.intakeBudgetResult",
      "Next": "CheckIntakeBudget"
    },
    "CheckIntakeBudget": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.intakeBudgetResult.Payload.authorized",
          "BooleanEquals": true,
          "Next": "CollectAttachments"
        }
      ],
      "Default": "BudgetDenied"
    },
    "ReserveAiBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardAiFunction}",
        "Payload": {
          "action": "reserve",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "reservationId.$": "States.Format('{}-ai', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.aiBudgetResult",
      "Next": "CheckAiBudget"
    },
    "CheckAiBudget": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.aiBudgetResult.Payload.authorized",
          "BooleanEquals": true,
          "Next": "RunExtraction"
        }
      ],
      "Default": "BudgetDenied"
    },
    "ReserveSheetDocBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardExternalFunction}",
        "Payload": {
          "action": "reserve",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "reservationId.$": "States.Format('{}-sheet-doc', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.sheetDocBudgetResult",
      "Next": "CheckSheetDocBudget"
    },
    "CheckSheetDocBudget": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sheetDocBudgetResult.Payload.authorized",
          "BooleanEquals": true,
          "Next": "CreateSheetOrDoc"
        }
      ],
      "Default": "BudgetDenied"
    },
    "SettleSheetDocBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "settle",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.sheetDocBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-sheet-doc', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.sheetdocSettlementResult",
      "Next": "RenderPdf"
    },
    "MarkSheetDocManualReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "manual_review",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.sheetDocBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-sheet-doc', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.sheetdocManualReviewResult",
      "Next": "ExternalActionManualReview"
    },
    "ReserveDeliveryBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardExternalFunction}",
        "Payload": {
          "action": "reserve",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "reservationId.$": "States.Format('{}-delivery', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.deliveryBudgetResult",
      "Next": "CheckDeliveryBudget"
    },
    "CheckDeliveryBudget": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.deliveryBudgetResult.Payload.authorized",
          "BooleanEquals": true,
          "Next": "DeliverArtifacts"
        }
      ],
      "Default": "BudgetDenied"
    },
    "SettleDeliveryBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "settle",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.deliveryBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-delivery', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.deliverySettlementResult",
      "Next": "SettleAiBudget"
    },
    "MarkDeliveryManualReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "manual_review",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.deliveryBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-delivery', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.deliveryManualReviewResult",
      "Next": "DeliveryManualReview"
    },
    "BudgetDenied": {
      "Type": "Fail",
      "Error": "BudgetDenied",
      "Cause": "Environment budget guard denied the operation"
    },
    "BudgetGuardUnavailable": {
      "Type": "Fail",
      "Error": "BudgetGuardUnavailable",
      "Cause": "Environment budget guard was unavailable; failed closed"
    },
    "SettleAiBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "settle",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.aiBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-ai', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.aiSettlementResult",
      "Next": "SettleIntakeBudget"
    },
    "SettleIntakeBudget": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CostGuardFunction}",
        "Payload": {
          "action": "settle",
          "schemaVersion": "novus.workflow-actions.v1",
          "workflowId.$": "$.workflowId",
          "invoiceMonth.$": "$.intakeBudgetResult.Payload.invoiceMonth",
          "reservationId.$": "States.Format('{}-intake', $.workflowId)"
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BudgetGuardUnavailable",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.intakeSettlementResult",
      "Next": "CompleteWorkflow"
    }
  }
}
