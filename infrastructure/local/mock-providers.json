{
  "schemaVersion": "novus.local-mocks.v1",
  "sanitized": true,
  "routes": [
    {
      "method": "POST",
      "path": "/botlocal-test-token/getChatMember",
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "user": { "id": 4242, "is_bot": false, "first_name": "Sandbox User" },
          "status": "member"
        }
      }
    },
    {
      "method": "POST",
      "path": "/botlocal-test-token/sendMessage",
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "message_id": 9001,
          "date": 0,
          "chat": { "id": -1000000000001, "type": "supergroup", "title": "Sandbox Forum" },
          "text": "Sandbox delivery accepted"
        }
      }
    },
    {
      "method": "GET",
      "path": "/o/oauth2/v2/auth",
      "status": 302,
      "headers": {
        "Content-Type": "application/json",
        "Location": "http://localhost:8081/oauth/callback?code=local-code&state=local-state"
      },
      "body": { "status": "sandbox_authorized" }
    },
    {
      "method": "POST",
      "path": "/oauth2/v4/token",
      "status": 200,
      "body": {
        "access_token": "local-access-token-not-a-secret",
        "refresh_token": "local-refresh-token-not-a-secret",
        "expires_in": 3600,
        "token_type": "Bearer",
        "scope": "openid email drive.file calendar.events"
      }
    },
    {
      "method": "POST",
      "path": "/drive/v3/files",
      "status": 200,
      "body": {
        "id": "sandbox-drive-file-1",
        "name": "sandbox-quotation.pdf",
        "mimeType": "application/pdf",
        "webViewLink": "http://localhost:8081/drive/files/sandbox-drive-file-1"
      }
    },
    {
      "method": "POST",
      "path": "/calendar/v3/calendars/primary/events",
      "status": 200,
      "body": {
        "id": "sandbox-calendar-event-1",
        "status": "confirmed",
        "htmlLink": "http://localhost:8081/calendar/events/sandbox-calendar-event-1",
        "summary": "Sandbox planning meeting"
      }
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "status": 200,
      "body": {
        "id": "sandbox-ai-response-1",
        "model": "sandbox-basic-reasoning",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "{\"schemaVersion\":\"novus.extraction.v1\",\"workflowType\":\"quotation\",\"status\":\"complete\",\"customerName\":\"Sandbox Customer\",\"lineItems\":[{\"description\":\"Sanitized sample service\",\"quantity\":1,\"unitPriceMinor\":10000,\"currency\":\"INR\"}]}"
            }
          }
        ],
        "usage": { "prompt_tokens": 24, "completion_tokens": 42, "total_tokens": 66 }
      }
    }
  ]
}
