# Copy this file to .env and fill only the providers you want to verify:
#   cp .env.example .env
#   chmod 600 .env
# Never commit .env.

# Local runtime selection
NOVUS_ENVIRONMENT=local

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_FORUM_CHAT_ID=
# Random 1-256 character [A-Za-z0-9_-] secret supplied to setWebhook and SAM.
TELEGRAM_WEBHOOK_SECRET=

# Google OAuth Web client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback
# Optional: enables live refresh-token and read-only API checks.
GOOGLE_OAUTH_REFRESH_TOKEN=
# Alternative to client ID/secret: an absolute path to a Web client JSON file.
# GOOGLE_OAUTH_CREDENTIALS_FILE=

# AI provider
# For Gemini, the local harness maps GEMINI_API_KEY to NOVUS_AI_PROVIDER_KEY.
GEMINI_API_KEY=

# Hostinger SMTP
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=587
HOSTINGER_SMTP_SECURITY=starttls
HOSTINGER_SMTP_USERNAME=
HOSTINGER_SMTP_PASSWORD=
